<?xml version='1.0'?>
<sdf version="1.4">
    <model name="grasspatch_no_collision">
        <static>true</static>
        <link name="link">

            
        <collision name="ground_collision">
            <pose>0 0 0 0 0 0</pose>
            <geometry>
            <plane>
                <normal>0 0 1</normal>
                <size>25 25</size>
            </plane>
            </geometry>
            <surface>
            <contact>
                <collide_bitmask>0xFFFF</collide_bitmask>
            </contact>
            <friction>
                <ode>
                <mu>0.5</mu>
                <mu2>0.5</mu2>
                </ode>
            </friction>
            </surface>
        </collision>


            <!-- The <collision> block has been completely removed to reduce the cpu usage when getting 50 of it -->
            <visual name="visual_s10">
                <pose>0 0 0 0 0 0</pose>
                <cast_shadows>false</cast_shadows>
                <geometry>
                    <plane>
                        <normal>0 0 1</normal>
                        <size>25 25</size>
                    </plane>
                </geometry>
                <material>
                    <diffuse>1.0 1.0 1.0</diffuse>
                    <specular>1.0 1.0 1.0</specular>
                    <pbr>
                        <metal>
                            <albedo_map>materials/textures/grass_dry.png</albedo_map>
                            <normal_map>materials/textures/grass_dry.png</normal_map>
                        </metal>
                    </pbr>
                </material>
            </visual>
        </link>
    </model>
</sdf>
