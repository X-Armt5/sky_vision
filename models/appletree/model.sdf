<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="appletree">
    <static>true</static>
    <link name="link">
      
      <!-- Use the exact same mesh for collisions! -->
      <collision name="collision">
        <!-- Exact same pose as the visual -->
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://appletree/meshes/appletree.obj</uri>
            <scale>8 8 8</scale>
          </mesh>
        </geometry>
      </collision>
      
      <!-- The visual mesh -->
      <visual name="visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://appletree/meshes/appletree.obj</uri>
            <scale>8 8 8</scale>
          </mesh>
        </geometry>
      </visual>

    </link>
  </model>
</sdf>
